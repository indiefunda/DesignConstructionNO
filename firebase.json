{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/kontakt", "destination": "/kontakt-oss", "type": 301 },
      { "source": "/en/contact", "destination": "/en/contact-us", "type": 301 },
      { "source": "/el/epikoinonia", "destination": "/el/epikinoniste-mazi-mas", "type": 301 },
      { "source": "/tjenester/snekker", "destination": "/tjenester/snekring", "type": 301 },
      { "source": "/en/services/carpentry", "destination": "/en/services/carpentry-works", "type": 301 },
      { "source": "/en/services/painting", "destination": "/en/services/painting-works", "type": 301 },
      { "source": "/en/services/plasterboard", "destination": "/en/services/plasterboard-works", "type": 301 },
      { "source": "/en/services/tiling", "destination": "/en/services/tiling-works", "type": 301 },
      { "source": "/en/services/demolition", "destination": "/en/services/demolitions-and-clean-ups", "type": 301 },
      { "source": "/gallery", "destination": "/galleri", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      },
      {
        "source": "/images/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/fonts/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
